# L.E.F.T.E. 構成設定テンプレート
# このファイルを .env にリネームして、自分の情報を入力してください。

# Gemini API 設定
# 取得先: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# サーバー設定 (Tailscale等を利用する場合はホスト名を変更)
HOST=0.0.0.0
PORT=5000

# SSL証明書設定 (TailscaleでHTTPS化する場合に指定)
# 指定しない場合は HTTP モードで起動します。
CERT_FILE=
KEY_FILE=

# VOICEVOX 設定
# デフォルトはローカル実行時のURLです。
VOICEVOX_URL=http://127.0.0.1:50021